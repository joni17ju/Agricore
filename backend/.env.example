# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers. Put the database name before the "?".
# Example shape (not a real cluster):
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agricore?retryWrites=true&w=majority
MONGODB_URI=

# Port the API listens on locally.
PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# Local Vite dev server by default; add the deployed frontend URL later.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Secret used to sign JWTs. Generate a long random value for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Brevo transactional email, used to send password reset codes.
# Brevo -> SMTP & API -> API Keys -> Generate a new API key (starts with "xkeysib-").
# Leave BREVO_API_KEY empty to disable sending: reset requests then fail loudly
# rather than silently pretending a code went out.
BREVO_API_KEY=

# Must be a sender address verified in Brevo -> Senders, Domains & Dedicated IPs.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=AgriCore
